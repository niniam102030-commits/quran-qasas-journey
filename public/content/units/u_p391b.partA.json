    {
      "verse": 47,
      "chunks": [
        {
          "from": 1,
          "to": 7,
          "fa": "و اگر نه آن بود که به سبب گناهانی که مرتکب شدند عذابی به آنان برسد، "
        },
        {
          "from": 8,
          "to": 13,
          "fa": "پس بگویند: پروردگارا! چرا پیامبری به سوی ما نفرستادی "
        },
        {
          "from": 14,
          "to": 18,
          "fa": "تا از آیاتت پیروی کنیم و از مؤمنان باشیم [بی تردید در عذاب کردن و هلاکتشان شتاب می نمودیم.]"
        }
      ],
      "faSegments": [
        "و اگر نه آن بود که به سبب گناهانی که مرتکب شدند عذابی به آنان برسد، ",
