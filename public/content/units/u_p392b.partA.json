    {
      "verse": 57,
      "chunks": [
        {
          "from": 1,
          "to": 5,
          "fa": "و [مشرکان برای معذور بودن خود در نپذیرفتن هدایت] گفتند: اگر ما همراه تو از هدایت [قرآن] پیروی کنیم"
        },
        {
          "from": 6,
          "to": 8,
          "fa": "[به وسیله مشرکان قلدر عرب] از سرزمینمان [شهر مکه] ربوده خواهیم شد!"
        },
        {
          "from": 9,
          "to": 13,
          "fa": "آیا ما آنان را در حرم امنی جای ندادیم"
        },
        {
          "from": 14,
          "to": 21,
          "fa": "که همواره [در همه فصول سال] هر نوع میوه و محصولی که رزقی از سوی ماست به سوی آن گردآوری می شود؟"
        },
        {
          "from": 22,
          "to": 25,
          "fa": "ولی بیشتر آنان معرفت و دانش [نسبت به واقعیات] ندارند."
        }
      ],
