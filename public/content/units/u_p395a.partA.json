      "verse": 78,
      "chunks": [
        {
          "from": 1,
          "to": 6,
          "fa": "گفت: جز این نیست که این [ثروت و مال انبوه] را بر پایه دانشی که نزد من است به من داده اند. "
        },
        {
          "from": 7,
          "to": 16,
          "fa": "آیا نمی دانست که خدا پیش از او اقوامی را هلاک کرده است "
        },
        {
          "from": 17,
          "to": 23,
          "fa": "که از او نیرومندتر و ثروت اندوزتر بودند؟ "
        },
        {
          "from": 24,
          "to": 28,
          "fa": "و مجرمان [که جرمشان معلوم و مشهود است] از گناهانشان بازپرسی نمی شود."
        }
      ],
      "faSegments": [
        "گفت: جز این نیست که این [ثروت و مال انبوه] را بر پایه دانشی که نزد من است به من داده اند. ",
        "آیا نمی دانست که خدا پیش از او اقوامی را هلاک کرده است ",
