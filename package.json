{
  "name": "quran-qasas-journey",
  "description": "سامانه تعاملی یادگیری واژگان سخت، ریشه‌شناسی و تله‌های معنایی سوره قصص برای فارسی‌زبانان",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fetch:base": "node scripts/fetch-base-data.mjs",
    "sync:qul": "node scripts/sync-qul-data.mjs",
    "build:inputs": "node scripts/build-ai-inputs.mjs",
    "merge:content": "node scripts/merge-parts.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:deep": "node scripts/validate-deep.mjs",
    "validate:all": "node scripts/validate-content.mjs --merged --strict && node scripts/validate-deep.mjs --strict",
    "build:manifest": "node scripts/build-manifest.mjs",
    "content:all": "node scripts/merge-parts.mjs && node scripts/validate-content.mjs --merged --strict && node scripts/validate-deep.mjs --strict && node scripts/build-manifest.mjs",
    "test": "vitest run",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "cap:build": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^14.9.0",
    "howler": "^2.2.4",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^6.0.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.8",
    "oxlint": "^1.89.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^3.2.4"
  }
}
